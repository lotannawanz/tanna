# Tanna Backend Environment Variables
# Copy this file to .env.local, .env.staging, or .env.production

# ===================
# ENVIRONMENT
# ===================
NODE_ENV=local  # local | staging | production
PORT=3000

# ===================
# DATABASE
# ===================
DATABASE_URL=postgresql://user:password@localhost:5432/tanna?schema=public

# ===================
# PAYSTACK (Placeholder)
# ===================
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# ===================
# WHATSAPP (Placeholder)
# ===================
WHATSAPP_API_TOKEN=xxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxx
WHATSAPP_BUSINESS_ACCOUNT_ID=xxxxxxxxxxxxx
