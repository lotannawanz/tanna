# Tanna Backend Environment Variables
# Copy this file to .env.local, .env.staging, or .env.production

# ===================
# ENVIRONMENT
# ===================
NODE_ENV=local  # local | staging | production
PORT=3000

# ===================
# DATABASE
# ===================
DATABASE_URL=postgresql://user:password@localhost:5432/tanna?schema=public

# ===================
# PAYSTACK (Placeholder)
# ===================
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# ===================
# WHATSAPP (Placeholder)
# ===================
WHATSAPP_API_TOKEN=xxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxx
WHATSAPP_BUSINESS_ACCOUNT_ID=xxxxxxxxxxxxx
WHATSAPP_VERIFY_TOKEN=random_secure_string_for_webhook_verification

# Template IDs (obtained after Meta approval)
WHATSAPP_TEMPLATE_BUYER_PAYMENT_CONFIRMED=buyer_payment_confirmed
WHATSAPP_TEMPLATE_VENDOR_NEW_ORDER=vendor_new_order
WHATSAPP_TEMPLATE_BUYER_ORDER_FULFILLED=buyer_order_fulfilled

# ===================
# AUTH (Epic 1)
# ===================
JWT_SECRET=your-secret-key-at-least-32-characters-long

# ===================
# CORS
# ===================
# Required in staging/production. In local dev, all origins are allowed.
FRONTEND_URL=https://your-frontend-domain.com

# ===================
# MONITORING
# ===================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Escalation — CRITICAL alerts only (optional)
PAGERDUTY_WEBHOOK_URL=https://events.pagerduty.com/v2/enqueue
PAGERDUTY_ROUTING_KEY=your-pagerduty-routing-key

# ===================
# ADMIN DASHBOARD
# ===================
ADMIN_API_KEY=your-admin-key-at-least-16-chars
ADMIN_DASHBOARD_ENABLED=false
