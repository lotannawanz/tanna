// Prisma Schema for Tanna
// Payment confirmation infrastructure for social commerce

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================
// VENDORS
// ===================
// Authenticated users who sell products
model Vendor {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  stores    Store[]

  @@map("vendors")
}

// ===================
// STORES
// ===================
// Public-facing storefronts owned by vendors
model Store {
  id        String   @id @default(uuid())
  vendorId  String   @map("vendor_id")
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  products  Product[]

  @@index([vendorId])
  @@map("stores")
}

// ===================
// PRODUCTS
// ===================
// Items for sale within a store
model Product {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  name        String
  description String?
  priceKobo   Int      @map("price_kobo") // Price in smallest unit (kobo)
  quantity    Int?     // Optional inventory tracking
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([storeId])
  @@index([isActive])
  @@map("products")
}

// ===================
// ORDERS
// ===================
// Immutable record of a purchase
// Contains snapshot of product at time of purchase
model Order {
  id              String   @id @default(uuid())
  productId       String   @map("product_id")
  vendorId        String   @map("vendor_id")
  
  // SNAPSHOT at time of purchase (immutable)
  // These fields capture the product state when the order was placed
  productName     String   @map("product_name")
  productPriceKobo Int     @map("product_price_kobo")
  productDesc     String?  @map("product_desc")
  
  // Buyer information
  buyerPhone      String   @map("buyer_phone")
  buyerEmail      String?  @map("buyer_email")
  
  createdAt       DateTime @default(now()) @map("created_at")
  
  product         Product  @relation(fields: [productId], references: [id])
  payment         Payment?

  @@index([vendorId])
  @@index([productId])
  @@index([createdAt])
  @@map("orders")
}

// ===================
// PAYMENTS
// ===================
// Payment records, separate from orders for clarity
// Payment status is FORWARD-ONLY: PENDING -> CONFIRMED or PENDING -> FAILED
model Payment {
  id              String        @id @default(uuid())
  orderId         String?       @unique @map("order_id")  // Optional - assigned after order creation
  internalRef     String        @unique @map("internal_ref")  // Our internal reference
  amountKobo      Int           @map("amount_kobo")
  currency        String        @default("NGN")
  status          PaymentStatus @default(PENDING)
  paystackRef     String?       @unique @map("paystack_ref")
  metadata        Json?         // Vendor/product references for reconciliation
  verifiedAt      DateTime?     @map("verified_at")
  failedAt        DateTime?     @map("failed_at")
  failureReason   String?       @map("failure_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  
  order           Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([paystackRef])
  @@index([internalRef])
  @@map("payments")
}

// Payment status enum - FORWARD ONLY
// Once CONFIRMED or FAILED, state cannot change
enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

// ===================
// WEBHOOK EVENTS
// ===================
// Raw storage of all webhook events for audit and idempotency
model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String    // "paystack", "whatsapp", etc.
  eventId     String    @unique @map("event_id") // Provider's event ID for deduplication
  eventType   String    @map("event_type")
  rawPayload  Json      @map("raw_payload")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([provider, eventType])
  @@index([createdAt])
  @@map("webhook_events")
}
