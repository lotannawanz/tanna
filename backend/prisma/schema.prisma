// Prisma Schema for Tanna
// Payment confirmation infrastructure for social commerce

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================
// VENDORS
// ===================
// Authenticated users who sell products
model Vendor {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  phone        String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  store        Store?   // 1:1 relationship

  @@map("vendors")
}

// ===================
// STORES
// ===================
// Public-facing storefronts owned by vendors
model Store {
  id                   String      @id @default(uuid())
  vendorId             String      @unique @map("vendor_id")  // Enforces 1:1
  name                 String
  slug                 String      @unique
  status               StoreStatus @default(ACTIVE)
  currency             String      @default("NGN")
  deliveryEstimateText String?     @map("delivery_estimate_text")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  products  Product[]

  @@index([status])
  @@map("stores")
}

// Store status enum
enum StoreStatus {
  ACTIVE
  PAUSED
}

// ===================
// PRODUCTS
// ===================
// Items for sale within a store
model Product {
  id          String        @id @default(uuid())
  storeId     String        @map("store_id")
  name        String
  slug        String        // URL-friendly identifier (unique per store)
  price       Int           @map("price_kobo") // Price in smallest unit (kobo)
  currency    String        @default("NGN")
  description String?
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([status])
  @@map("products")
}

// Product status enum
enum ProductStatus {
  ACTIVE
  PAUSED
}

// ===================
// ORDERS
// ===================
// Immutable record of a purchase
// Created at checkout initiation, status updated via webhook
model Order {
  id              String      @id @default(uuid())
  vendorId        String      @map("vendor_id")
  paymentId       String?     @unique @map("payment_id")  // Nullable until payment linked
  status          OrderStatus @default(AWAITING_PAYMENT)
  
  // Buyer information
  buyerPhone      String      @map("buyer_phone")
  buyerEmail      String?     @map("buyer_email")
  
  // Totals
  totalAmountKobo Int         @map("total_amount_kobo")
  
  // Timestamps
  createdAt       DateTime    @default(now()) @map("created_at")
  confirmedAt     DateTime?   @map("confirmed_at")
  fulfilledAt     DateTime?   @map("fulfilled_at")
  
  // Relations
  items           OrderItem[]
  payment         Payment?    @relation(fields: [paymentId], references: [id])

  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

// ===================
// ORDER ITEMS
// ===================
// Frozen snapshot of product at time of purchase
// No FK to Product - immutable record independent of product changes
model OrderItem {
  id                String   @id @default(uuid())
  orderId           String   @map("order_id")
  
  // SNAPSHOT at time of purchase (frozen, immutable)
  productName       String   @map("product_name")
  unitPriceKobo     Int      @map("unit_price_kobo")
  quantity          Int
  
  // Optional: original product reference for audit (not a FK)
  originalProductId String?  @map("original_product_id")
  
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

// Order status enum - FORWARD ONLY transitions
enum OrderStatus {
  CREATED           // Order shell created (internal state)
  AWAITING_PAYMENT  // Checkout initiated, waiting for payment
  CONFIRMED         // Payment verified via webhook
  FULFILLED         // Vendor marked as fulfilled
  CANCELLED         // Payment failed or cancelled
  REFUNDED          // Refund processed
}

// ===================
// PAYMENTS
// ===================
// Payment records, separate from orders for clarity
// Payment status is FORWARD-ONLY: PENDING -> CONFIRMED or PENDING -> FAILED
model Payment {
  id              String        @id @default(uuid())
  internalRef     String        @unique @map("internal_ref")  // Our internal reference
  amountKobo      Int           @map("amount_kobo")
  currency        String        @default("NGN")
  status          PaymentStatus @default(PENDING)
  paystackRef     String?       @unique @map("paystack_ref")
  metadata        Json?         // Vendor/product references for reconciliation
  verifiedAt      DateTime?     @map("verified_at")
  failedAt        DateTime?     @map("failed_at")
  failureReason   String?       @map("failure_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  
  // Relation: Order now owns this reference
  order           Order?

  @@index([status])
  @@index([paystackRef])
  @@index([internalRef])
  @@map("payments")
}

// Payment status enum - FORWARD ONLY
// Once CONFIRMED or FAILED, state cannot change
enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

// ===================
// WEBHOOK EVENTS
// ===================
// Raw storage of all webhook events for audit and idempotency
model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String    // "paystack", "whatsapp", etc.
  eventId     String    @unique @map("event_id") // Provider's event ID for deduplication
  eventType   String    @map("event_type")
  rawPayload  Json      @map("raw_payload")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([provider, eventType])
  @@index([createdAt])
  @@map("webhook_events")
}

// ===================
// MESSAGE LOGS
// ===================
// Tracks all WhatsApp message sends for debugging, resends, and audit
model MessageLog {
  id                String        @id @default(uuid())
  orderId           String        @map("order_id")
  recipientPhone    String        @map("recipient_phone")
  templateName      String        @map("template_name")
  status            MessageStatus @default(PENDING)
  providerMessageId String?       @map("provider_message_id")
  errorMessage      String?       @map("error_message")
  createdAt         DateTime      @default(now()) @map("created_at")
  sentAt            DateTime?     @map("sent_at")

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("message_logs")
}

// Message delivery status
enum MessageStatus {
  PENDING
  SENT
  FAILED
}

// ===================
// JOB QUEUE
// ===================
// Durable Postgres-backed job queue
// Replaces inline webhook processing and fire-and-forget notifications

enum JobType {
  WEBHOOK_PROCESS
  SEND_WHATSAPP
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD
}

model Job {
  id          String    @id @default(uuid())
  type        JobType
  payload     Json
  status      JobStatus @default(PENDING)
  retryCount  Int       @default(0) @map("retry_count")
  maxRetries  Int       @default(5) @map("max_retries")
  availableAt DateTime  @default(now()) @map("available_at")
  lockedAt    DateTime? @map("locked_at")
  lockedBy    String?   @map("locked_by")
  lastError   String?   @map("last_error")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@index([type])
  @@index([lockedAt])
  @@map("jobs")
}

// ===================
// SYSTEM HEALTH
// ===================
// Worker heartbeat tracking for operational monitoring
model SystemHealth {
  component     String   @id
  lastHeartbeat DateTime @map("last_heartbeat")
  metadata      Json?

  @@map("system_health")
}
